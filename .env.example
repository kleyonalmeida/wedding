# ════════════════════════════════════════════════════════════════════════════
# INSTRUÇÕES:
#   1. Copie este arquivo: cp .env.example .env
#   2. Preencha TODOS os valores no arquivo .env
#   3. NUNCA faça commit do arquivo .env (já está no .gitignore)
#
# Este arquivo fica na RAIZ do projeto e é lido pelo Docker Compose
# para interpolação de variáveis (${VAR}) no docker-compose.yml.
# ════════════════════════════════════════════════════════════════════════════

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# ── API — Origem do Flutter Web ──────────────────────────────────────────────
# Exemplo: https://casamento.seudominio.com.br
ALLOWED_ORIGIN=

# Admin inicial: troque a senha no primeiro acesso e configure MFA.
SUPERADMIN_EMAIL=
SUPERADMIN_INITIAL_PASSWORD=

# Asaas e URL HTTPS publica do site. Publique a porta local 8080 por um proxy TLS.
ASAAS_ENVIRONMENT=Sandbox
ASAAS_API_KEY=
ASAAS_WEBHOOK_AUTH_TOKEN=
PUBLIC_BASE_URL=
